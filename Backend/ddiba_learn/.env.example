AI_PROVIDER=openai

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=your_openrouter_model_here
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,ddiba-learn.onrender.com
CORS_ALLOWED_ORIGINS=https://ddiba.onrender.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Optional persistent PostgreSQL connection (SQLite is used when omitted).
# DATABASE_URL=postgresql://user:password@host/database
